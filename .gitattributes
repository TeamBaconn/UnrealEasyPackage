# Normalize line endings: LF in the repo, native on checkout.
* text=auto

# Force LF for these regardless of platform.
*.rs    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Treat as binary (no EOL munging, no diff).
*.png   binary
*.ico   binary
*.icns  binary
*.jpg   binary
*.webp  binary
